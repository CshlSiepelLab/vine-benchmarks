BootStrap: docker
From: python:3.10-slim

%labels
    Description "Python 3.10 and LAML v1.0.5 with some bash commands installed."

%files
    laml.def /opt/laml/laml.def

# LAML needs an active (not expired) Mosek license. It is deliberately not
# copied into the image: Mosek reads $HOME/mosek/mosek.lic at run time, and
# Singularity mounts the running user's home directory into the container.

%post
    set -eux

    apt-get update && \
    apt-get install -y --no-install-recommends \
        git \
        build-essential \
        less \
        vim \
        nano \
        procps \
        wget \
        curl \
        ca-certificates \
        time && \
        rm -rf /var/lib/apt/lists/*

    # Install Cassiopeia
    pip install laml==1.0.5
    pip install scikit-bio==0.7.4

%environment
    export PATH="/usr/local/bin:$PATH"

%runscript
    exec "$@"





