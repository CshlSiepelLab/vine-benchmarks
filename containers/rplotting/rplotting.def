Bootstrap: docker
From: rocker/r-ver:4.3.2

%labels
    Author Stephen_Staklinski
    Description "Reusable R plotting container with common plotting packages and phylogenetic packages."

%environment
    export LC_ALL=C
    export LANG=C

%post

    apt-get update && apt-get install -y \
        libcurl4-openssl-dev \
        libssl-dev \
        libxml2-dev \
        libfontconfig1-dev \
        libharfbuzz-dev \
        libfribidi-dev \
        libcairo2-dev \
        libfreetype6-dev \
        libpng-dev \
        libtiff5-dev \
        libjpeg-dev \
        libxt-dev \
        git \
        && apt-get clean

    # CRAN packages, pinned to the CRAN snapshot of the image's build date
    # (2026-11-16) via Posit Package Manager: ggplot2 4.0.4, cowplot 1.2.0,
    # patchwork 1.3.2, dplyr 1.2.1, scales 1.4.0, ape 5.7.1, phytools 2.1.1, ...
    # ggpubr and ragg were listed here but never installed in the benchmark image
    # (ragg needs FreeType headers at build time), so they are left out.
    R -e "install.packages(c(
        'ggplot2',
        'cowplot',
        'patchwork',
        'gridExtra',
        'dplyr',
        'tidyr',
        'data.table',
        'readr',
        'reshape2',
        'viridis',
        'scales',
        'RColorBrewer',
        'igraph',
        'ggraph',
        'tidygraph',
        'svglite',
        'Cairo',
        'extrafont',
        'showtext',
        'optparse',
        'ape',
        'phytools'
    ), repos='https://packagemanager.posit.co/cran/2026-11-16')"

    # Bioconductor 3.18 (matches R 4.3): treeio 1.26.0. ggtree, listed here
    # originally, fails to install against ggplot2 4.x; Figure 5 adds it from
    # install_fig5_lib.sh instead.
    R -e "install.packages('BiocManager', repos='https://packagemanager.posit.co/cran/2026-11-16')"
    R -e "options(repos = c(CRAN = 'https://packagemanager.posit.co/cran/2026-11-16')); BiocManager::install(version = '3.18', ask = FALSE, update = FALSE); BiocManager::install('treeio', ask = FALSE, update = FALSE)"

%runscript
    exec R "$@"