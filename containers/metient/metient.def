Bootstrap: docker
From: python:3.9-slim

%post
    apt-get update -y && \
    apt-get install -y --no-install-recommends \
        graphviz \
        libgraphviz-dev \
        gcc \
        g++ \
        git \
        build-essential \
        less \
        vim \
        nano \
        procps \
        wget \
        curl \
        ca-certificates \
        time \
        libbz2-dev \
        zlib1g-dev \
        liblzma-dev && \
        rm -rf /var/lib/apt/lists/*

    pip install --no-cache-dir pygraphviz==1.11 ipython==8.18.1
    # pinned: python/src/run_metient_evaluate.py uses the pre-1.0 API (metient v0.1.3.5.3)
    pip install --no-cache-dir metient==0.1.3.5.3

%runscript
    #!/bin/bash
    "$@"




