BootStrap: docker
From: python:3.10-slim

%labels
    Description "Python 3.10 and Cassiopeia with other basic python package dependencies and some bash commands installed."

%files
    cassiopeia.def /opt/cassiopeia/cassiopeia.def

%post
    set -eux

    apt-get update && \
    apt-get install -y --no-install-recommends \
        git \
        build-essential \
        less \
        vim \
        nano \
        procps \
        wget \
        curl \
        ca-certificates \
        time && \
        rm -rf /var/lib/apt/lists/*

    # Install Cassiopeia
    # pinned to the commit installed for the benchmarks (cassiopeia-lineage 2.1.0)
    pip install git+https://github.com/YosefLab/Cassiopeia@1ee5959eb9d3f8d4d26e2af5678234493bf54d6d#egg=cassiopeia-lineage
    
    # Install other dependencies
    pip install umi_tools==1.1.6 ete3==3.1.3 numpy==2.2.6 scipy==1.15.3

%environment
    export PATH="/usr/local/bin:$PATH"

%runscript
    exec "$@"





